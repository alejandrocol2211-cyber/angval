const PRODUCTS_STORAGE_KEY = "angval_admin_products";

try {
  const stored = localStorage.getItem(PRODUCTS_STORAGE_KEY);
  if (stored) {
    const parsed = JSON.parse(stored) as Product[];
    if (Array.isArray(parsed)) PRODUCTS.splice(0, PRODUCTS.length, ...parsed);
  }
} catch {
  // Keep the bundled catalog when local storage is unavailable or invalid.
}

export function saveManagedProducts(products: Product[]) {
  PRODUCTS.splice(0, PRODUCTS.length, ...products);
  localStorage.setItem(PRODUCTS_STORAGE_KEY, JSON.stringify(products));
}

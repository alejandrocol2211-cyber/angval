const RELEVANCE_ORDER: Record<string, number> = {
  "Más Vendido": 1,
  "Exclusivo": 2,
  "Nuevo": 3,
  "Lujo": 4,
  "Oferta": 5,
};

function StarRating({ rating, small }: { rating: number; small?: boolean }) {
  return (
    <div className="flex items-center gap-px">
      {[1, 2, 3, 4, 5].map((s) => (
        <Star key={s} className={`${small ? "w-3 h-3" : "w-3.5 h-3.5"} ${s <= Math.round(rating) ? "fill-[#C9973A] text-[#C9973A]" : "text-gray-200"}`} />
      ))}
    </div>
  );
}

function ProductCard({ product, view }: { product: Product; view: "grid" | "list" }) {
  const { addToCart, toggleWishlist, wishlist, setCartOpen } = useCart();
  const inWishlist = wishlist.includes(product.id);

  function handleAdd(e: React.MouseEvent) {
    e.preventDefault();
    addToCart(product);
    setCartOpen(true);
  }

  if (view === "list") {
    return (
      <Link to={`/producto/${product.id}`} className="group block">
        <div className="bg-card rounded-2xl border border-border hover:shadow-lg transition-all duration-200 flex overflow-hidden">
          <div className="relative w-36 sm:w-44 flex-shrink-0 bg-muted">
            <img src={product.image} alt={product.name} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            {product.badge && (
              <span className={`absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded-full ${BADGE_STYLES[product.badge]}`}>
                {product.badge}
              </span>
            )}
          </div>
          <div className="flex-1 p-5 flex flex-col justify-between">
            <div>
              <p className="text-[10px] font-semibold text-[#C9973A] uppercase tracking-widest mb-1">{product.brand}</p>
              <h3 className="text-base font-semibold text-foreground mb-1 group-hover:text-[#B8324A] transition-colors">{product.name}</h3>
              <p className="text-xs text-muted-foreground mb-2 line-clamp-2">{product.description}</p>
              <div className="flex items-center gap-2 mb-3">
                <StarRating rating={product.rating} />
                <span className="text-xs text-muted-foreground">({product.reviews.toLocaleString()})</span>
              </div>
            </div>
            <div className="flex items-center justify-between">
              <div className="flex items-baseline gap-1.5">
                <span className="text-xl font-bold text-[#B8324A]">${product.price.toFixed(2)}</span>
                {product.originalPrice && <span className="text-sm text-muted-foreground line-through">${product.originalPrice.toFixed(2)}</span>}
              </div>
              <div className="flex gap-2">
                <button onClick={(e) => { e.preventDefault(); toggleWishlist(product.id); }}
                  className="p-2 border border-border rounded-full hover:border-[#B8324A] transition-colors">
                  <Heart className={`w-4 h-4 ${inWishlist ? "fill-[#B8324A] text-[#B8324A]" : "text-muted-foreground"}`} />
                </button>
                <button onClick={handleAdd}
                  className="flex items-center gap-1.5 bg-[#B8324A] hover:bg-[#9e2a3f] text-white px-4 py-2 rounded-full text-xs font-semibold transition-colors">
                  <ShoppingBag className="w-3.5 h-3.5" /> Agregar
                </button>
              </div>
            </div>
          </div>
        </div>
      </Link>
    );
  }

  return (
    <Link to={`/producto/${product.id}`} className="group block">
      <div className="bg-card rounded-2xl overflow-hidden border border-border hover:shadow-xl hover:shadow-black/8 transition-all duration-300 hover:-translate-y-1">
        <div className="relative aspect-square overflow-hidden bg-muted">
          <img src={product.image} alt={product.name} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          {product.badge && (
            <span className={`absolute top-3 left-3 text-[10px] font-bold px-2.5 py-1 rounded-full ${BADGE_STYLES[product.badge]}`}>
              {product.badge}
            </span>
          )}
          <button onClick={(e) => { e.preventDefault(); toggleWishlist(product.id); }}
            className="absolute top-3 right-3 p-1.5 bg-card/90 hover:bg-card rounded-full shadow-sm transition-all opacity-0 group-hover:opacity-100">
            <Heart className={`w-3.5 h-3.5 ${inWishlist ? "fill-[#B8324A] text-[#B8324A]" : "text-muted-foreground"}`} />
          </button>
          <button onClick={handleAdd}
            className="absolute bottom-0 left-0 right-0 bg-[#B8324A]/95 hover:bg-[#B8324A] text-white text-xs font-semibold py-2.5 translate-y-full group-hover:translate-y-0 transition-transform duration-300 flex items-center justify-center gap-1.5">
            <ShoppingBag className="w-3.5 h-3.5" /> Agregar al carrito
          </button>
        </div>
        <div className="p-4">
          <p className="text-[10px] font-semibold text-[#C9973A] uppercase tracking-widest mb-1">{product.brand}</p>
          <h3 className="text-sm font-semibold text-foreground leading-snug mb-2 line-clamp-2 group-hover:text-[#B8324A] transition-colors">{product.name}</h3>
          <div className="flex items-center gap-1.5 mb-3">
            <StarRating rating={product.rating} small />
            <span className="text-[10px] text-muted-foreground">({product.reviews.toLocaleString()})</span>
          </div>
          <div className="flex items-baseline gap-1.5">
            <span className="text-base font-bold text-[#B8324A]">${product.price.toFixed(2)}</span>
            {product.originalPrice && (
              <>
                <span className="text-xs text-muted-foreground line-through">${product.originalPrice.toFixed(2)}</span>
                <span className="text-[10px] font-semibold text-green-600 bg-green-50 px-1.5 py-0.5 rounded">
                  -{Math.round((1 - product.price / product.originalPrice) * 100)}%
                </span>
              </>
            )}
          </div>
        </div>
      </div>
    </Link>
  );
}

export function Catalog() {
  const [searchParams, setSearchParams] = useSearchParams();

  const [query, setQuery] = useState("");
  const [category, setCategory] = useState(searchParams.get("cat") || "Todos");
  const [subcategory, setSubcategory] = useState(searchParams.get("sub") || "");
  const [sort, setSort] = useState("relevance");
  const [badgeFilter, setBadgeFilter] = useState<string | null>(searchParams.get("badge") || null);
  const [view, setView] = useState<"grid" | "list">("grid");
  const [showFilters, setShowFilters] = useState(false);
  const [priceMax, setPriceMax] = useState(200);
  const [showSort, setShowSort] = useState(false);

  useEffect(() => {
    const cat = searchParams.get("cat");
    if (cat) setCategory(cat);
    const sub = searchParams.get("sub");
    if (sub) setSubcategory(sub);
    const badge = searchParams.get("badge");
    if (badge) setBadgeFilter(badge);
  }, [searchParams]);

  const subcats = SUBCATEGORIES[category] || SUBCATEGORIES["Todos"];

  const filtered = useMemo(() => {
    let arr = [...PRODUCTS];
    if (category !== "Todos") arr = arr.filter((p) => p.category === category);
    if (subcategory) arr = arr.filter((p) => p.subcategory === subcategory);
    if (badgeFilter) arr = arr.filter((p) => p.badge === badgeFilter);
    if (query) {
      const q = query.toLowerCase();
      arr = arr.filter((p) =>
        p.name.toLowerCase().includes(q) ||
        p.brand.toLowerCase().includes(q) ||
        p.subcategory.toLowerCase().includes(q)
      );
    }
    arr = arr.filter((p) => p.price <= priceMax);

    switch (sort) {
      case "price_asc": arr.sort((a, b) => a.price - b.price); break;
      case "price_desc": arr.sort((a, b) => b.price - a.price); break;
      case "rating": arr.sort((a, b) => b.rating - a.rating); break;
      case "reviews": arr.sort((a, b) => b.reviews - a.reviews); break;
      case "relevance":
      default:
        arr.sort((a, b) => {
          const ra = RELEVANCE_ORDER[a.badge || ""] || 9;
          const rb = RELEVANCE_ORDER[b.badge || ""] || 9;
          if (ra !== rb) return ra - rb;
          return b.reviews - a.reviews;
        });
    }
    return arr;
  }, [category, subcategory, badgeFilter, query, sort, priceMax]);

  function clearFilters() {
    setCategory("Todos");
    setSubcategory("");
    setBadgeFilter(null);
    setQuery("");
    setPriceMax(200);
    setSort("relevance");
    setSearchParams({});
  }

  const hasFilters = category !== "Todos" || subcategory || badgeFilter || query || priceMax < 200;

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      {/* Header */}
      <div className="mb-6">
        <nav className="text-xs text-muted-foreground mb-2">
          <Link to="/tienda" className="hover:text-[#B8324A] transition-colors">Inicio</Link>
          <span className="mx-2">/</span>
          <span className="text-foreground font-medium">Catálogo</span>
          {category !== "Todos" && <><span className="mx-2">/</span><span className="text-foreground font-medium">{category}</span></>}
          {subcategory && <><span className="mx-2">/</span><span className="text-foreground font-medium">{subcategory}</span></>}
        </nav>
        <h1 className="text-3xl sm:text-4xl font-bold text-foreground" style={{ fontFamily: "'Playfair Display', serif" }}>
          {subcategory || category === "Todos" ? subcategory || "Catálogo Completo" : category}
        </h1>
        <p className="text-muted-foreground text-sm mt-1">{filtered.length} productos encontrados</p>
      </div>

      {/* Category tabs */}
      <div className="flex gap-2 flex-wrap mb-4">
        {CATEGORIES.map((cat) => (
          <button
            key={cat}
            onClick={() => { setCategory(cat); setSubcategory(""); }}
            className={`px-4 py-2 rounded-full text-sm font-medium transition-all whitespace-nowrap ${
              category === cat
                ? "bg-[#B8324A] text-white shadow-md shadow-[#B8324A]/25"
                : "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* Subcategory chips */}
      <div className="flex gap-2 flex-wrap mb-6 overflow-x-auto pb-1">
        {subcats.map((sc) => (
          <button
            key={sc.label}
            onClick={() => setSubcategory(subcategory === sc.label ? "" : sc.label)}
            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border whitespace-nowrap transition-all ${
              subcategory === sc.label
                ? "bg-[#2A1520] text-white border-[#2A1520]"
                : "bg-card border-border text-muted-foreground hover:border-[#B8324A] hover:text-[#B8324A]"
            }`}
          >
            <span>{sc.emoji}</span>
            {sc.label}
          </button>
        ))}
      </div>

      {/* Search + view controls */}
      <div className="flex flex-col sm:flex-row gap-3 mb-6">
        <div className="relative flex-1">
          <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
          <input
            type="text"
            placeholder="Buscar productos, marcas..."
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            className="w-full pl-11 pr-4 py-3 bg-card border border-border rounded-full text-sm text-foreground placeholder:text-muted-foreground outline-none focus:border-[#B8324A] focus:ring-2 focus:ring-[#B8324A]/10 transition-all"
          />
          {query && (
            <button onClick={() => setQuery("")} className="absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground">
              <X className="w-4 h-4" />
            </button>
          )}
        </div>
        <div className="flex gap-2">
          <button
            onClick={() => setShowFilters(!showFilters)}
            className={`flex items-center gap-2 px-4 py-3 rounded-full border text-sm font-medium transition-colors ${
              showFilters || hasFilters ? "bg-[#B8324A] text-white border-[#B8324A]" : "bg-card border-border text-foreground hover:border-[#B8324A]"
            }`}
          >
            <SlidersHorizontal className="w-4 h-4" />
            Filtros
            {hasFilters && !showFilters && <span className="w-2 h-2 rounded-full bg-white" />}
          </button>
          <div className="relative">
            <button
              onClick={() => setShowSort(!showSort)}
              className="flex items-center gap-2 px-4 py-3 rounded-full border border-border bg-card text-sm font-medium text-foreground hover:border-[#B8324A] transition-colors"
            >
              <ArrowUpDown className="w-4 h-4" />
              <span className="hidden sm:inline">{SORT_OPTIONS.find((o) => o.value === sort)?.label}</span>
              <ChevronDown className="w-4 h-4" />
            </button>
            {showSort && (
              <div className="absolute right-0 top-full mt-2 bg-card border border-border rounded-xl shadow-lg overflow-hidden z-20 min-w-[220px]">
                {SORT_OPTIONS.map((o) => (
                  <button key={o.value} onClick={() => { setSort(o.value); setShowSort(false); }}
                    className={`w-full text-left px-4 py-2.5 text-sm hover:bg-muted transition-colors ${
                      sort === o.value ? "text-[#B8324A] font-semibold bg-accent" : "text-foreground"
                    }`}
                  >
                    {o.label}
                  </button>
                ))}
              </div>
            )}
          </div>
          <button
            onClick={() => setView(view === "grid" ? "list" : "grid")}
            className="p-3 rounded-full border border-border bg-card text-foreground hover:border-[#B8324A] transition-colors"
          >
            {view === "grid" ? <LayoutList className="w-4 h-4" /> : <Grid3X3 className="w-4 h-4" />}
          </button>
        </div>
      </div>

      <div className="flex gap-6">
        {/* Sidebar */}
        {showFilters && (
          <aside className="w-56 flex-shrink-0">
            <div className="bg-card border border-border rounded-2xl p-5 space-y-5 sticky top-24">
              <div>
                <h4 className="text-sm font-bold text-foreground mb-3">Destacados</h4>
                <div className="flex flex-wrap gap-2">
                  {BADGE_FILTERS.map((b) => (
                    <button key={b} onClick={() => setBadgeFilter(badgeFilter === b ? null : b)}
                      className={`text-xs px-3 py-1.5 rounded-full border transition-colors ${
                        badgeFilter === b ? "bg-[#2A1520] text-white border-[#2A1520]" : "border-border text-muted-foreground hover:border-foreground"
                      }`}
                    >
                      {b}
                    </button>
                  ))}
                </div>
              </div>
              <div>
                <h4 className="text-sm font-bold text-foreground mb-3">Precio máximo</h4>
                <div className="space-y-2">
                  <input
                    type="range" min={5} max={200} step={5} value={priceMax}
                    onChange={(e) => setPriceMax(Number(e.target.value))}
                    className="w-full accent-[#B8324A]"
                  />
                  <div className="flex justify-between text-xs text-muted-foreground">
                    <span>$0</span><span className="font-semibold text-[#B8324A]">${priceMax}</span>
                  </div>
                </div>
              </div>
              {hasFilters && (
                <button onClick={clearFilters} className="w-full text-sm text-[#B8324A] font-semibold hover:underline">
                  Limpiar filtros
                </button>
              )}
            </div>
          </aside>
        )}

        {/* Grid */}
        <div className="flex-1 min-w-0">
          {/* Active pills */}
          {(subcategory || badgeFilter) && (
            <div className="flex flex-wrap gap-2 mb-4">
              {subcategory && (
                <span className="inline-flex items-center gap-1 bg-accent text-foreground text-xs font-medium px-3 py-1.5 rounded-full border border-border">
                  {subcategory}
                  <button onClick={() => setSubcategory("")}><X className="w-3 h-3 ml-0.5" /></button>
                </span>
              )}
              {badgeFilter && (
                <span className="inline-flex items-center gap-1 bg-accent text-foreground text-xs font-medium px-3 py-1.5 rounded-full border border-border">
                  {badgeFilter}
                  <button onClick={() => setBadgeFilter(null)}><X className="w-3 h-3 ml-0.5" /></button>
                </span>
              )}
            </div>
          )}

          {filtered.length === 0 ? (
            <div className="flex flex-col items-center justify-center py-24 text-center">
              <Search className="w-12 h-12 text-muted-foreground/30 mb-4" />
              <h3 className="text-lg font-semibold text-foreground mb-2">Sin resultados</h3>
              <p className="text-muted-foreground text-sm mb-4">Intenta con otros filtros.</p>
              <button onClick={clearFilters} className="text-sm text-[#B8324A] font-semibold hover:underline">
                Limpiar filtros
              </button>
            </div>
          ) : view === "grid" ? (
            <div className="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
              {filtered.map((p) => <ProductCard key={p.id} product={p} view="grid" />)}
            </div>
          ) : (
            <div className="space-y-4">
              {filtered.map((p) => <ProductCard key={p.id} product={p} view="list" />)}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

import { useEffect, useState } from "react";
import { useNavigate } from "react-router";
import { Logo } from "../components/Logo";
import { ArrowRight, Sparkles } from "lucide-react";

export function Splash() {
  const navigate = useNavigate();
  const [loaded, setLoaded] = useState(false);
  const [exiting, setExiting] = useState(false);

  useEffect(() => {
    const t = setTimeout(() => setLoaded(true), 100);
    return () => clearTimeout(t);
  }, []);

  function enter() {
    setExiting(true);
    setTimeout(() => navigate("/tienda"), 700);
  }

  return (
    <div
      className="fixed inset-0 overflow-hidden cursor-pointer select-none"
      style={{
        opacity: exiting ? 0 : 1,
        transition: "opacity 0.7s ease",
      }}
      onClick={enter}
    >
      {/* Background image */}
      <div className="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1631730359585-38a4935cbec4?w=1600&h=900&fit=crop&auto=format"
          alt="Beauty Rush"
          className="w-full h-full object-cover"
        />
        <div className="absolute inset-0 bg-gradient-to-br from-[#2A1520]/95 via-[#2A1520]/75 to-[#4A2535]/60" />
      </div>

      {/* Decorative circles */}
      <div className="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-[#B8324A]/10 blur-3xl pointer-events-none" />
      <div className="absolute bottom-1/3 left-1/4 w-72 h-72 rounded-full bg-[#C9973A]/10 blur-3xl pointer-events-none" />

      {/* Content */}
      <div
        className="relative z-10 flex flex-col items-center justify-center h-full text-center px-6"
        style={{
          opacity: loaded ? 1 : 0,
          transform: loaded ? "translateY(0)" : "translateY(24px)",
          transition: "opacity 1s ease 0.2s, transform 1s ease 0.2s",
        }}
      >
        {/* Logo */}
        <div className="mb-10 scale-150">
          <Logo size="lg" variant="light" />
        </div>

        {/* Tagline */}
        <div className="max-w-lg mb-4">
          <h1
            className="text-5xl sm:text-6xl md:text-7xl font-bold text-white leading-none mb-6"
            style={{ fontFamily: "'Playfair Display', serif" }}
          >
            Tu belleza,
            <br />
            <span className="italic text-transparent" style={{ WebkitTextStroke: "1.5px #C9973A" }}>
              sin límites.
            </span>
          </h1>
          <p className="text-white/60 text-base sm:text-lg font-light tracking-wide">
            Cosméticos premium · Skincare · Perfumería
          </p>
        </div>

        {/* Divider */}
        <div className="w-16 h-px bg-gradient-to-r from-transparent via-[#C9973A] to-transparent my-8" />

        {/* CTA */}
        <button
          className="group flex flex-col items-center gap-3"
          onClick={enter}
        >
          <div className="w-16 h-16 rounded-full border-2 border-white/30 flex items-center justify-center group-hover:border-[#C9973A] transition-colors duration-300 relative">
            <ArrowRight className="w-6 h-6 text-white/70 group-hover:text-[#C9973A] transition-colors duration-300" />
            {/* Pulse ring */}
            <div className="absolute inset-0 rounded-full border border-white/20 scale-110 animate-ping opacity-50" />
          </div>
          <span className="text-white/50 text-xs tracking-[0.3em] uppercase font-medium">
            Toca para entrar
          </span>
        </button>

        {/* Bottom badges */}
        <div className="absolute bottom-8 left-0 right-0 flex justify-center gap-6 flex-wrap px-6">
          {["100% Original", "Envío Gratis", "Devoluciones 30 días"].map((t) => (
            <div key={t} className="flex items-center gap-1.5 text-white/40 text-xs">
              <Sparkles className="w-3 h-3 text-[#C9973A]/60" />
              {t}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

      id: editingProduct?.id || Math.max(0, ...products.map((product) => product.id)) + 1,
      name: productForm.name.trim(),
      brand: productForm.brand.trim(),
      category: productForm.category,
      subcategory: productForm.subcategory.trim() || "General",
      price,
      stock,
      image: productForm.image.trim() || "https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&h=600&fit=crop&auto=format",

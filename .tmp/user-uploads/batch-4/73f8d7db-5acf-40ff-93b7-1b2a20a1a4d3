                        <TableRow key={product.id}>
                          <TableCell>
                            <div className="flex items-center gap-3">
                              <img src={product.image} alt="" className="size-12 rounded-lg bg-muted object-cover" />
                              <div className="max-w-72">
                                <div className="truncate font-medium">{product.name}</div>
                                <div className="text-xs text-muted-foreground">{product.brand} · ID {product.id}</div>
                              </div>
                            </div>
                          </TableCell>
                          <TableCell><Badge variant="outline">{product.category}</Badge></TableCell>
                          <TableCell className="font-medium">${product.price.toFixed(2)}</TableCell>
                          <TableCell>
                            <Badge variant={product.stock < 10 ? "destructive" : product.stock <= 20 ? "secondary" : "outline"}>
                              {product.stock} unidades
                            </Badge>
                          </TableCell>
                          <TableCell>
                            <div className="flex justify-end gap-1">
                              <Button variant="ghost" size="icon" onClick={() => openProduct(product)} aria-label={isAdmin ? "Editar producto" : "Ajustar stock"}>
                                <Pencil />
                              </Button>
                              {isAdmin && (
                                <Button variant="ghost" size="icon" className="text-destructive hover:text-destructive" onClick={() => deleteProduct(product)} aria-label="Eliminar producto">
                                  <Trash2 />
                                </Button>
                              )}
                            </div>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                  {filteredProducts.length === 0 && <div className="p-12 text-center text-sm text-muted-foreground">No se encontraron productos.</div>}
                </CardContent>
              </Card>
            </>
          )}

          {section === "orders" && (
            <>
              <div className="flex flex-col gap-3 sm:flex-row">
                <div className="relative flex-1">
                  <Search className="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
                  <Input className="pl-10" placeholder="Buscar pedido, cliente, ciudad o estado" value={query} onChange={(event) => setQuery(event.target.value)} />
                </div>
                {hasPermission("exports") && <Button
                  variant="outline"
                  onClick={() => downloadCsv("pedidos-angval.csv", [
                    ["Pedido", "Cliente", "Ciudad", "Total", "Transportadora", "Estado"],
                    ...orders.map((order) => [order.id, order.customer, order.city, order.total, order.carrier, order.status]),
                  ])}
                >
                  <Download /> Exportar
                </Button>}
              </div>
              <div className="grid gap-3 sm:grid-cols-3">
                {[
                  { label: "Por preparar", value: orders.filter((order) => ["Pendiente", "Preparando"].includes(order.status)).length },
                  { label: "En tránsito", value: orders.filter((order) => order.status === "Despachado").length },
                  { label: "Completados", value: orders.filter((order) => order.status === "Entregado").length },
                ].map((item) => (
                  <Card key={item.label} className="gap-2 p-5">
                    <CardDescription>{item.label}</CardDescription>
                    <CardTitle className="font-serif text-3xl">{item.value}</CardTitle>
                  </Card>
                ))}
              </div>
              <Card>
                <CardContent className="p-0">
                  <Table>
                    <TableHeader>
                      <TableRow>
                        <TableHead>Pedido</TableHead>
                        <TableHead>Cliente</TableHead>
                        <TableHead>Destino</TableHead>
                        <TableHead>Total</TableHead>
                        <TableHead>Transportadora</TableHead>
                        <TableHead>Estado</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {filteredOrders.map((order) => (
                        <TableRow key={order.id}>
                          <TableCell>
                            <div className="font-semibold">{order.id}</div>
                            <div className="text-xs text-muted-foreground">{order.date} · {order.items} artículos</div>
                          </TableCell>
                          <TableCell>
                            <div>{order.customer}</div>
                            <div className="text-xs text-muted-foreground">{order.email}</div>
                          </TableCell>
                          <TableCell>{order.city}</TableCell>
                          <TableCell className="font-semibold">${order.total.toFixed(2)}</TableCell>
                          <TableCell>{order.carrier}</TableCell>
                          <TableCell>
                            <Select value={order.status} onValueChange={(value) => updateOrderStatus(order.id, value as OrderStatus)}>
                              <SelectTrigger className="w-40"><SelectValue /></SelectTrigger>
                              <SelectContent>
                                {["Pendiente", "Preparando", "Despachado", "Entregado", "Cancelado"].map((status) => (
                                  <SelectItem key={status} value={status}>{status}</SelectItem>
                                ))}
                              </SelectContent>
                            </Select>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </CardContent>
              </Card>
            </>
          )}

          {section === "customers" && (hasPermission("viewCustomers") || hasPermission("manageCustomers")) && (
            <>
              {isAdmin && (
                <Card>
                  <CardHeader>
                    <CardTitle className="flex items-center gap-2"><UserCog className="size-5 text-primary" /> Roles y permisos</CardTitle>
                    <CardDescription>
                      Las cuentas nuevas se crean siempre como Cliente. Puedes convertirlas en subadministradores y elegir sus permisos.
                    </CardDescription>
                  </CardHeader>
                  <CardContent className="p-0">
                    <Table>
                      <TableHeader>
                        <TableRow>
                          <TableHead>Cuenta</TableHead>
                          <TableHead>Rol actual</TableHead>
                          <TableHead>Permisos habilitados</TableHead>
                          <TableHead className="text-right">Acción</TableHead>
                        </TableRow>
                      </TableHeader>
                      <TableBody>
                        {accounts.map((account) => (
                          <TableRow key={account.email}>
                            <TableCell>
                              <div className="font-medium">{account.name}</div>
                              <div className="text-xs text-muted-foreground">{account.email}</div>
                            </TableCell>
                            <TableCell>
                              <Badge variant={account.role === "admin" ? "default" : account.role === "deputy" ? "secondary" : "outline"}>
                                {account.role === "admin" ? "Administrador" : account.role === "deputy" ? "Subadministrador" : "Cliente"}
                              </Badge>
                            </TableCell>
                            <TableCell>
                              <div className="max-w-md text-xs text-muted-foreground">
                                {account.role === "admin"
                                  ? "Acceso total"
                                  : account.permissions.length
                                    ? account.permissions.map((permission) => PERMISSION_OPTIONS.find((option) => option.id === permission)?.label).filter(Boolean).join(", ")
                                    : "Sin permisos administrativos"}
                              </div>
                            </TableCell>
                            <TableCell className="text-right">
                              <Button
                                variant="outline"
                                size="sm"
                                disabled={account.role === "admin"}
                                onClick={() => openAccountAccess(account)}
                              >
                                <UserCog /> Asignar acceso
                              </Button>
                            </TableCell>
                          </TableRow>
                        ))}
                      </TableBody>
                    </Table>
                    {accounts.length <= 2 && (
                      <div className="border-t border-border p-5 text-sm text-muted-foreground">
                        Los usuarios aparecerán aquí después de registrarse desde la tienda.
                      </div>
                    )}
                  </CardContent>
                </Card>
              )}

              <Card>
                <CardHeader>
                  <CardTitle>Directorio de clientes</CardTitle>
                  <CardDescription>Consulta actividad y controla el estado comercial de las cuentas.</CardDescription>
                </CardHeader>
                <CardContent className="p-0">
                  <Table>
                    <TableHeader>
                      <TableRow>
                        <TableHead>Cliente</TableHead>
                        <TableHead>Pedidos</TableHead>
                        <TableHead>Compra acumulada</TableHead>
                        <TableHead>Estado</TableHead>
                        {hasPermission("manageCustomers") && <TableHead className="text-right">Acción</TableHead>}
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {customers.map((customer) => (
                        <TableRow key={customer.id}>
                          <TableCell>
                            <div className="font-medium">{customer.name}</div>
                            <div className="text-xs text-muted-foreground">{customer.email} · {customer.id}</div>
                          </TableCell>
                          <TableCell>{customer.orders}</TableCell>
                          <TableCell className="font-medium">${customer.spent.toFixed(2)}</TableCell>
                          <TableCell>
                            <Badge variant={customer.status === "Activo" ? "outline" : "destructive"}>{customer.status}</Badge>
                          </TableCell>
                          {hasPermission("manageCustomers") && (
                            <TableCell className="text-right">
                              <Button variant="outline" size="sm" onClick={() => toggleCustomer(customer.id)}>
                                {customer.status === "Activo" ? "Suspender" : "Reactivar"}
                              </Button>
                            </TableCell>
                          )}
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </CardContent>
              </Card>
            </>
          )}

          {section === "settings" && hasPermission("settings") && (
            <div className="grid gap-6 lg:grid-cols-2">
              <Card>
                <CardHeader>
                  <CardTitle>Automatización operativa</CardTitle>
                  <CardDescription>Define las alertas y reglas del flujo logístico.</CardDescription>
                </CardHeader>
                <CardContent className="space-y-5">
                  {[
                    { key: "lowStockAlerts" as const, title: "Alertas de stock bajo", description: "Avisar cuando un producto tenga 20 unidades o menos." },
                    { key: "orderNotifications" as const, title: "Notificaciones de pedidos", description: "Mostrar alertas al recibir una nueva compra." },
                    { key: "autoDispatch" as const, title: "Despacho automático", description: "Enviar pedidos pagados a preparación sin revisión manual." },
                  ].map((item) => (
                    <div key={item.key} className="flex items-center justify-between gap-5 rounded-xl border border-border p-4">
                      <div>
                        <div className="text-sm font-semibold">{item.title}</div>
                        <div className="text-xs text-muted-foreground">{item.description}</div>
                      </div>
                      <Switch checked={settings[item.key]} onCheckedChange={(value) => saveSetting(item.key, value)} />
                    </div>
                  ))}
                </CardContent>
              </Card>
              <Card>
                <CardHeader>
                  <CardTitle>Roles y permisos</CardTitle>
                  <CardDescription>Resumen de las capacidades asignadas al equipo.</CardDescription>
                </CardHeader>
                <CardContent className="space-y-4">
                  <div className="rounded-xl border border-border p-4">
                    <div className="mb-1 flex items-center gap-2 font-semibold"><ShieldCheck className="size-4 text-primary" /> Administrador</div>
                    <div className="text-sm text-muted-foreground">Acceso total a catálogo, pedidos, clientes, reportes y configuración.</div>
                  </div>
                  <div className="rounded-xl border border-border p-4">
                    <div className="mb-1 flex items-center gap-2 font-semibold"><Truck className="size-4 text-secondary" /> Suplente de administrador</div>
                    <div className="text-sm text-muted-foreground">Sus capacidades se asignan individualmente desde Clientes y roles. Nunca puede crear roles ni eliminar productos.</div>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}
        </div>
      </main>

      <Dialog open={productDialog} onOpenChange={setProductDialog}>
        <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-2xl">
          <DialogHeader>
            <DialogTitle>{!isAdmin ? "Ajustar inventario" : editingProduct ? "Editar producto" : "Nuevo producto"}</DialogTitle>
            <DialogDescription>
              {!isAdmin ? "Como suplente, solo puedes modificar las unidades disponibles." : "Los cambios se reflejarán en el catálogo público de la tienda."}
            </DialogDescription>
          </DialogHeader>
          <form onSubmit={submitProduct} className="space-y-5">
            <div className="grid gap-4 sm:grid-cols-2">
              <div className="space-y-2 sm:col-span-2">
                <Label htmlFor="product-name">Nombre</Label>
                <Input id="product-name" required disabled={!isAdmin} value={productForm.name} onChange={(event) => setProductForm({ ...productForm, name: event.target.value })} />
              </div>
              <div className="space-y-2">
                <Label htmlFor="product-brand">Marca</Label>
                <Input id="product-brand" required disabled={!isAdmin} value={productForm.brand} onChange={(event) => setProductForm({ ...productForm, brand: event.target.value })} />
              </div>
              <div className="space-y-2">
                <Label>Categoría</Label>
                <Select disabled={!isAdmin} value={productForm.category} onValueChange={(value) => setProductForm({ ...productForm, category: value })}>
                  <SelectTrigger><SelectValue /></SelectTrigger>
                  <SelectContent>
                    {CATEGORIES.filter((category) => category !== "Todos").map((category) => (
                      <SelectItem key={category} value={category}>{category}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-2">
                <Label htmlFor="product-price">Precio</Label>
                <Input id="product-price" type="number" min="0.01" step="0.01" required disabled={!isAdmin} value={productForm.price} onChange={(event) => setProductForm({ ...productForm, price: event.target.value })} />
              </div>
              <div className="space-y-2">
                <Label htmlFor="product-stock">Unidades disponibles</Label>
                <Input id="product-stock" type="number" min="0" required value={productForm.stock} onChange={(event) => setProductForm({ ...productForm, stock: event.target.value })} />
              </div>
              {isAdmin && (
                <>
                  <div className="space-y-2 sm:col-span-2">
                    <Label htmlFor="product-image">URL de imagen</Label>
                    <Input id="product-image" type="url" value={productForm.image} onChange={(event) => setProductForm({ ...productForm, image: event.target.value })} placeholder="https://..." />
                  </div>
                  <div className="space-y-2 sm:col-span-2">
                    <Label htmlFor="product-description">Descripción</Label>
                    <Textarea id="product-description" value={productForm.description} onChange={(event) => setProductForm({ ...productForm, description: event.target.value })} />
                  </div>
                </>
              )}
            </div>
            <DialogFooter>
              <Button type="button" variant="outline" onClick={() => setProductDialog(false)}>Cancelar</Button>
              <Button type="submit">{!isAdmin ? "Guardar inventario" : editingProduct ? "Guardar cambios" : "Crear producto"}</Button>
            </DialogFooter>
          </form>
        </DialogContent>
      </Dialog>

      <Dialog open={accessDialog} onOpenChange={setAccessDialog}>
        <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-xl">
          <DialogHeader>
            <DialogTitle>Asignar rol y permisos</DialogTitle>
            <DialogDescription>
              Configura el acceso de {editingAccount?.name}. Los cambios se aplicarán en su próximo inicio de sesión.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-5">
            <div className="space-y-2">
              <Label>Rol de la cuenta</Label>
              <Select
                value={accessRole}
                onValueChange={(value) => {
                  const role = value as "customer" | "deputy";
                  setAccessRole(role);
                  if (role === "customer") setAccessPermissions([]);
                }}
              >
                <SelectTrigger><SelectValue /></SelectTrigger>
                <SelectContent>
                  <SelectItem value="customer">Cliente</SelectItem>
                  <SelectItem value="deputy">Subadministrador</SelectItem>
                </SelectContent>
              </Select>
              <div className="text-xs text-muted-foreground">
                El rol Cliente no tiene acceso al panel administrativo.
              </div>
            </div>

            <div className={accessRole === "customer" ? "pointer-events-none space-y-3 opacity-40" : "space-y-3"}>
              <div>
                <div className="text-sm font-semibold">Permisos del subadministrador</div>
                <div className="text-xs text-muted-foreground">Selecciona únicamente las funciones necesarias para esta cuenta.</div>
              </div>
              {PERMISSION_OPTIONS.map((permission) => (
                <Label
                  key={permission.id}
                  htmlFor={`permission-${permission.id}`}
                  className="flex cursor-pointer items-start gap-3 rounded-xl border border-border p-4"
                >
                  <Checkbox
                    id={`permission-${permission.id}`}
                    checked={accessPermissions.includes(permission.id)}
                    disabled={accessRole === "customer"}
                    onCheckedChange={(checked) => togglePermission(permission.id, checked === true)}
                  />
                  <span className="space-y-1">
                    <span className="block text-sm font-semibold">{permission.label}</span>
                    <span className="block text-xs font-normal text-muted-foreground">{permission.description}</span>
                  </span>
                </Label>
              ))}
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setAccessDialog(false)}>Cancelar</Button>
            <Button onClick={saveAccountAccess}>Guardar acceso</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}

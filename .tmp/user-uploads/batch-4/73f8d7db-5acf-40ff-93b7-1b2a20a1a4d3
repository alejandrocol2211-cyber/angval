      reviews: editingProduct?.reviews || 0,
      description: productForm.description.trim(),
      details: editingProduct?.details || ["Producto original", "Disponible en AngVal Beauty"],
      badge: editingProduct?.badge,
      originalPrice: editingProduct?.originalPrice,
    };
    persistProducts(editingProduct
      ? products.map((product) => product.id === editingProduct.id ? payload : product)
      : [payload, ...products]);
    setProductDialog(false);
    showNotice(editingProduct ? "Producto actualizado correctamente." : "Producto creado correctamente.");

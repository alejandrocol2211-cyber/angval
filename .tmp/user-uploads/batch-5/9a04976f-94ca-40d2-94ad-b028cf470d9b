import { Outlet, Link, useLocation, useNavigate } from "react-router";
import {
  ShoppingBag, Heart, Menu, X, Minus, Plus, Trash2, ArrowRight,
  Instagram, Facebook, Twitter, Sparkles, Sun, Moon, User, LogOut,
  ChevronDown, MessageCircle,
} from "lucide-react";
import { useState, useRef, useEffect } from "react";
import { Logo } from "./Logo";
import { useCart } from "../context/CartContext";
import { useAuth } from "../context/AuthContext";
import { useDarkMode } from "../context/DarkModeContext";

const NAV_LINKS = [
  { label: "Inicio", to: "/tienda" },
  { label: "Catálogo", to: "/catalogo" },
  { label: "Nosotros", to: "/nosotros" },
  { label: "Contacto", to: "/contacto" },
];

function CartDrawer() {
  const { cart, cartCount, cartTotal, cartOpen, setCartOpen, removeFromCart, updateQty } = useCart();
  const navigate = useNavigate();

  if (!cartOpen) return null;

  const shipping = cartTotal >= 30 ? 0 : 8.99;

  return (
    <div className="fixed inset-0 z-50 flex">
      <div className="flex-1 bg-black/40 backdrop-blur-sm" onClick={() => setCartOpen(false)} />
      <div className="w-full max-w-sm bg-card h-full flex flex-col shadow-2xl">
        <div className="flex items-center justify-between px-6 py-5 border-b border-border">
          <div>
            <h2 className="text-lg font-bold text-foreground" style={{ fontFamily: "'Playfair Display', serif" }}>
              Mi Carrito
            </h2>
            <p className="text-xs text-muted-foreground">{cartCount} producto{cartCount !== 1 ? "s" : ""}</p>
          </div>
          <button onClick={() => setCartOpen(false)} className="p-2 hover:bg-muted rounded-full transition-colors">
            <X className="w-5 h-5 text-foreground" />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto px-6 py-4 space-y-4">
          {cart.length === 0 ? (
            <div className="flex flex-col items-center justify-center h-full gap-4 text-center py-12">
              <ShoppingBag className="w-14 h-14 text-muted-foreground/30" />
              <div>
                <p className="text-foreground font-semibold mb-1">Tu carrito está vacío</p>
                <p className="text-muted-foreground text-sm">Agrega productos para comenzar</p>
              </div>
              <button onClick={() => { setCartOpen(false); navigate("/catalogo"); }}
                className="text-sm text-[#B8324A] font-semibold hover:underline">
                Explorar productos →
              </button>
            </div>
          ) : (
            cart.map((item) => (
              <div key={item.id} className="flex gap-3 py-2">
                <Link to={`/producto/${item.id}`} onClick={() => setCartOpen(false)}
                  className="w-16 h-16 rounded-xl overflow-hidden bg-muted flex-shrink-0">
                  <img src={item.image} alt={item.name} className="w-full h-full object-cover" />
                </Link>
                <div className="flex-1 min-w-0">
                  <p className="text-sm font-semibold text-foreground truncate">{item.name}</p>
                  <p className="text-xs text-muted-foreground">{item.brand}</p>
                  <div className="flex items-center justify-between mt-2">
                    <div className="flex items-center gap-1.5 border border-border rounded-full px-2 py-1">
                      <button onClick={() => updateQty(item.id, -1)} className="w-4 h-4 flex items-center justify-center hover:text-[#B8324A]">
                        <Minus className="w-3 h-3" />
                      </button>
                      <span className="text-xs font-semibold w-4 text-center">{item.quantity}</span>
                      <button onClick={() => updateQty(item.id, 1)} className="w-4 h-4 flex items-center justify-center hover:text-[#B8324A]">
                        <Plus className="w-3 h-3" />
                      </button>
                    </div>
                    <p className="text-sm font-bold text-[#B8324A]">${(item.price * item.quantity).toFixed(2)}</p>
                    <button onClick={() => removeFromCart(item.id)} className="text-muted-foreground hover:text-destructive p-1">
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </div>
            ))
          )}
        </div>

        {cart.length > 0 && (
          <div className="px-6 py-5 border-t border-border space-y-4 bg-muted/30">
            <div className="space-y-1.5">
              <div className="flex justify-between text-sm">
                <span className="text-muted-foreground">Subtotal</span>
                <span className="font-semibold text-foreground">${cartTotal.toFixed(2)}</span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-muted-foreground">Envío</span>
                <span className={shipping === 0 ? "text-green-600 font-semibold" : "text-foreground"}>
                  {shipping === 0 ? "Gratis" : `$${shipping.toFixed(2)}`}
                </span>
              </div>
              {cartTotal < 30 && (
                <p className="text-xs text-[#C9973A]">Agrega ${(30 - cartTotal).toFixed(2)} más para envío gratis</p>
              )}
            </div>
            <div className="border-t border-border pt-3 flex justify-between">
              <span className="text-sm font-bold text-foreground">Total</span>
              <span className="text-lg font-bold text-[#B8324A]">${(cartTotal + shipping).toFixed(2)}</span>
            </div>
            <button
              onClick={() => { setCartOpen(false); navigate("/checkout"); }}
              className="w-full bg-[#B8324A] hover:bg-[#9e2a3f] text-white py-3.5 rounded-full font-semibold text-sm flex items-center justify-center gap-2 shadow-md shadow-[#B8324A]/20 transition-colors"
            >
              Finalizar compra <ArrowRight className="w-4 h-4" />
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

function UserMenu() {
  const { user, logout, setAuthOpen, setAuthMode } = useAuth();
  const navigate = useNavigate();
  const [open, setOpen] = useState(false);
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    function handler(e: MouseEvent) {
      if (ref.current && !ref.current.contains(e.target as Node)) setOpen(false);
    }
    document.addEventListener("mousedown", handler);
    return () => document.removeEventListener("mousedown", handler);
  }, []);

  if (!user) {
    return (
      <div className="hidden sm:flex items-center gap-1">
        <button
          onClick={() => { setAuthMode("login"); navigate("/auth"); }}
          className="px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
        >
          Iniciar sesión
        </button>
        <button
          onClick={() => { setAuthMode("register"); navigate("/auth"); }}
          className="px-4 py-1.5 text-xs font-bold bg-[#B8324A] text-white rounded-full hover:bg-[#9e2a3f] transition-colors"
        >
          Registrarse
        </button>
      </div>
    );
  }

  return (
    <div className="relative hidden sm:block" ref={ref}>
      <button
        onClick={() => setOpen((o) => !o)}
        className="flex items-center gap-2 px-3 py-1.5 rounded-full hover:bg-muted transition-colors"
      >
        <div className="w-6 h-6 rounded-full bg-gradient-to-br from-[#B8324A] to-[#C9973A] flex items-center justify-center text-white text-[10px] font-bold">
          {user.name.charAt(0).toUpperCase()}
        </div>
        <span className="text-xs font-semibold text-foreground max-w-[80px] truncate">{user.name.split(" ")[0]}</span>
        <ChevronDown className="w-3 h-3 text-muted-foreground" />
      </button>
      {open && (
        <div className="absolute right-0 top-full mt-2 bg-card border border-border rounded-2xl shadow-xl overflow-hidden z-50 min-w-[180px]">
          <div className="px-4 py-3 border-b border-border">
            <p className="text-xs font-bold text-foreground truncate">{user.name}</p>
            <p className="text-[10px] text-muted-foreground truncate">{user.email}</p>
          </div>
          <div>
            {(user.role === "admin" || user.role === "deputy") && (
              <button onClick={() => { setOpen(false); navigate("/admin"); }}
                className="w-full flex items-center gap-2 px-4 py-2.5 text-xs font-semibold text-primary hover:bg-muted transition-colors">
                <Sparkles className="w-3.5 h-3.5" /> Panel administrativo
              </button>
            )}
            <button onClick={() => { setOpen(false); navigate("/auth"); }}
              className="w-full flex items-center gap-2 px-4 py-2.5 text-xs text-foreground hover:bg-muted transition-colors">
              <User className="w-3.5 h-3.5" /> Mi cuenta
            </button>
            <button onClick={() => { setOpen(false); navigate("/favoritos"); }}
              className="w-full flex items-center gap-2 px-4 py-2.5 text-xs text-foreground hover:bg-muted transition-colors">
              <Heart className="w-3.5 h-3.5" /> Favoritos
            </button>
            <button onClick={() => { logout(); setOpen(false); }}
              className="w-full flex items-center gap-2 px-4 py-2.5 text-xs text-destructive hover:bg-muted transition-colors border-t border-border">
              <LogOut className="w-3.5 h-3.5" /> Cerrar sesión
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

function Header() {
  const location = useLocation();
  const navigate = useNavigate();
  const { cartCount, wishlist, setCartOpen } = useCart();
  const { user, setAuthMode } = useAuth();
  const { dark, toggle } = useDarkMode();
  const [mobileOpen, setMobileOpen] = useState(false);

  const isActive = (to: string) => location.pathname === to;

  return (
    <header className="sticky top-0 z-40 bg-card/98 backdrop-blur border-b border-border shadow-sm">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
        {/* Logo */}
        <Link to="/tienda" className="flex-shrink-0">
          <Logo />
        </Link>

        {/* Nav desktop */}
        <nav className="hidden lg:flex items-center gap-1">
          {NAV_LINKS.map((link) => (
            <Link
              key={link.to}
              to={link.to}
              className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
                isActive(link.to)
                  ? "bg-[#B8324A]/8 text-[#B8324A]"
                  : "text-muted-foreground hover:text-foreground hover:bg-muted"
              }`}
            >
              {link.label}
            </Link>
          ))}
        </nav>

        {/* Right actions */}
        <div className="flex items-center gap-0.5 flex-shrink-0">
          {/* Auth buttons (desktop) */}
          <UserMenu />

          {/* Dark mode */}
          <button
            onClick={toggle}
            className="p-2.5 hover:bg-muted rounded-full transition-colors"
            title={dark ? "Modo claro" : "Modo oscuro"}
          >
            {dark ? <Sun className="w-4.5 h-4.5 text-[#C9973A] w-5 h-5" /> : <Moon className="w-5 h-5 text-foreground" />}
          </button>

          {/* Wishlist */}
          <button
            onClick={() => navigate("/favoritos")}
            className="p-2.5 hover:bg-muted rounded-full transition-colors relative"
          >
            <Heart className={`w-5 h-5 ${wishlist.length > 0 ? "text-[#B8324A] fill-[#B8324A]" : "text-foreground"}`} />
            {wishlist.length > 0 && (
              <span className="absolute -top-0.5 -right-0.5 w-4 h-4 bg-[#B8324A] text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                {wishlist.length}
              </span>
            )}
          </button>

          {/* Cart */}
          <button
            onClick={() => setCartOpen(true)}
            className="p-2.5 hover:bg-muted rounded-full transition-colors relative"
          >
            <ShoppingBag className="w-5 h-5 text-foreground" />
            {cartCount > 0 && (
              <span className="absolute -top-0.5 -right-0.5 w-4 h-4 bg-[#B8324A] text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                {cartCount}
              </span>
            )}
          </button>

          {/* Mobile menu */}
          <button
            className="lg:hidden p-2.5 hover:bg-muted rounded-full transition-colors"
            onClick={() => setMobileOpen(true)}
          >
            <Menu className="w-5 h-5 text-foreground" />
          </button>
        </div>
      </div>

      {/* Mobile Menu */}
      {mobileOpen && (
        <div className="fixed inset-0 z-50 bg-card flex flex-col">
          <div className="flex justify-between items-center px-6 py-5 border-b border-border">
            <Logo />
            <button onClick={() => setMobileOpen(false)} className="p-2 hover:bg-muted rounded-full">
              <X className="w-5 h-5 text-foreground" />
            </button>
          </div>
          <nav className="flex flex-col px-6 py-6 gap-1 flex-1 overflow-y-auto">
            {NAV_LINKS.map((link) => (
              <Link
                key={link.to}
                to={link.to}
                onClick={() => setMobileOpen(false)}
                className={`text-left text-base font-medium py-3.5 px-4 rounded-xl transition-colors ${
                  isActive(link.to) ? "bg-[#B8324A]/8 text-[#B8324A]" : "text-foreground hover:bg-muted"
                }`}
              >
                {link.label}
              </Link>
            ))}
            <Link to="/favoritos" onClick={() => setMobileOpen(false)}
              className="text-left text-base font-medium py-3.5 px-4 rounded-xl text-foreground hover:bg-muted transition-colors flex items-center gap-2">
              <Heart className="w-4 h-4 text-[#B8324A]" /> Favoritos {wishlist.length > 0 && `(${wishlist.length})`}
            </Link>
            <div className="border-t border-border pt-4 mt-2 space-y-2">
              {user ? (
                <>
                  <div className="px-4 py-3 bg-muted rounded-xl flex items-center gap-3">
                    <div className="w-8 h-8 rounded-full bg-gradient-to-br from-[#B8324A] to-[#C9973A] flex items-center justify-center text-white text-xs font-bold">
                      {user.name.charAt(0)}
                    </div>
                    <div>
                      <p className="text-sm font-semibold text-foreground">{user.name}</p>
                      <p className="text-xs text-muted-foreground">{user.email}</p>
                    </div>
                  </div>
                  <Link to="/auth" onClick={() => setMobileOpen(false)}
                    className="block text-sm font-medium py-3 px-4 rounded-xl text-foreground hover:bg-muted transition-colors">
                    Mi cuenta
                  </Link>
                </>
              ) : (
                <div className="flex gap-2">
                  <Link to="/auth" onClick={() => { setAuthMode("login"); setMobileOpen(false); }}
                    className="flex-1 text-center py-3 border border-border rounded-full text-sm font-semibold text-foreground hover:bg-muted transition-colors">
                    Iniciar sesión
                  </Link>
                  <Link to="/auth" onClick={() => { setAuthMode("register"); setMobileOpen(false); }}
                    className="flex-1 text-center py-3 bg-[#B8324A] rounded-full text-sm font-bold text-white hover:bg-[#9e2a3f] transition-colors">
                    Registrarse
                  </Link>
                </div>
              )}
              <button onClick={() => { toggle(); }}
                className="w-full flex items-center gap-2 py-3 px-4 rounded-xl text-sm font-medium text-foreground hover:bg-muted transition-colors">
                {dark ? <Sun className="w-4 h-4 text-[#C9973A]" /> : <Moon className="w-4 h-4" />}
                {dark ? "Modo claro" : "Modo oscuro"}
              </button>
            </div>
          </nav>
        </div>
      )}
    </header>
  );
}

function Footer() {
  return (
    <footer className="bg-[#2A1520] dark:bg-black text-white/70 mt-auto">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
          <div>
            <div className="mb-5"><Logo variant="light" /></div>
            <p className="text-sm leading-relaxed mb-5">
              Tu destino de belleza favorito. Cosméticos y cuidado personal 100% originales a precios accesibles.
            </p>
            <div className="flex gap-3">
              {[Instagram, Facebook, Twitter].map((Icon, i) => (
                <button key={i} className="p-2.5 bg-white/10 hover:bg-[#B8324A] rounded-full transition-colors">
                  <Icon className="w-4 h-4 text-white" />
                </button>
              ))}
            </div>
          </div>
          {[
            { title: "Tienda", links: [{ l: "Catálogo", to: "/catalogo" }, { l: "Maquillaje", to: "/catalogo?cat=Maquillaje" }, { l: "Skincare", to: "/catalogo?cat=Skincare" }, { l: "Perfumes", to: "/catalogo?cat=Perfumes" }] },
            { title: "Ayuda", links: [{ l: "Nosotros", to: "/nosotros" }, { l: "Contacto", to: "/contacto" }, { l: "Devoluciones", to: "#" }, { l: "Seguimiento", to: "#" }] },
            { title: "Cuenta", links: [{ l: "Iniciar sesión", to: "/auth" }, { l: "Registrarse", to: "/auth" }, { l: "Mis pedidos", to: "/auth" }, { l: "Favoritos", to: "/favoritos" }] },
          ].map((col) => (
            <div key={col.title}>
              <h4 className="text-white font-bold text-sm mb-4">{col.title}</h4>
              <ul className="space-y-2.5">
                {col.links.map((link) => (
                  <li key={link.l}>
                    <Link to={link.to} className="text-sm hover:text-white transition-colors">{link.l}</Link>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div className="border-t border-white/10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs">
          <div className="flex items-center gap-2">
            <Sparkles className="w-3.5 h-3.5 text-[#C9973A]" />
            <p>© 2026 Beauty Rush Cosmetics. Todos los derechos reservados.</p>
          </div>
          <a
            href="https://wa.me/573219341523"
            target="_blank"
            rel="noopener noreferrer"
            className="flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-full text-xs font-semibold transition-colors"
          >
            <MessageCircle className="w-3.5 h-3.5" /> WhatsApp Soporte
          </a>
        </div>
      </div>
    </footer>
  );
}

export function Root() {
  const location = useLocation();
  const isSplash = location.pathname === "/";
  const isAdmin = location.pathname.startsWith("/admin");

  if (isSplash || isAdmin) return <Outlet />;

  return (
    <div className="min-h-screen flex flex-col bg-background" style={{ fontFamily: "'DM Sans', sans-serif" }}>
      <Header />
      <CartDrawer />
      <main className="flex-1">
        <Outlet />
      </main>
      <Footer />
    </div>
  );
}
